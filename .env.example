# ============================================================
# PORTFOLIOFORGE — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in values
# ============================================================

# ─── MongoDB ─────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/portfolioforge
# Atlas:   mongodb+srv://user:pass@cluster.mongodb.net/portfolioforge
MONGODB_URI="mongodb://localhost:27017/portfolioforge"

# ─── NextAuth ────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth (optional) ─────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── GitHub OAuth (optional) ─────────────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Image Upload (Local Storage) ────────────────────────────
# Images save hongi: public/uploads/ folder mein
UPLOAD_DIR="public/uploads"
NEXT_PUBLIC_UPLOAD_URL="/uploads"
MAX_FILE_SIZE="10485760"

# ─── Anthropic AI ────────────────────────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Email (Gmail SMTP) ──────────────────────────────────────
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your@gmail.com"
EMAIL_PASS="gmail-app-password"
EMAIL_FROM="PortfolioForge <your@gmail.com>"

# ─── App Config ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PortfolioForge"
